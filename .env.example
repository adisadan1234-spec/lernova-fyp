# PostgreSQL connection used by Prisma. Replace these development-only values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lernova?schema=public"

# Express API
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Free MyMemory translation needs no account or API key. Anonymous use is
# limited to 5,000 source characters per day. Urdu output sends the original
# message and its locally simplified restatement externally for translation.
# Use "mock" when developing without external requests.
LANGUAGE_PROCESSING_PROVIDER="mymemory"
LANGUAGE_PROCESSING_TIMEOUT_MS=15000
