# PostgreSQL connection used by Prisma. Replace these development-only values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lernova?schema=public"

# Express API
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Language processing remains mock-only until a real provider is selected.
# Keep any future provider key in the server environment; never expose it to Vite.
LANGUAGE_PROCESSING_PROVIDER="mock"
LANGUAGE_PROCESSING_API_KEY=""
LANGUAGE_PROCESSING_TIMEOUT_MS=15000
